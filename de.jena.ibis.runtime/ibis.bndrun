-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'
-runee: JavaSE-17

#-runstartlevel: \
#	order=sortbynameversion
	
-runbundles+: de.jena.*;startlevel=1000,\
	*;startlevel=10

-runprovidedcapabilities: ${native_capability}
-resolve.effective: active
-runvm: -Dconfigurator.initial='file:///opt/ibis/bus359.config'	

-runblacklist: \
	bnd.identity;id='org.gecko.emf.osgi.api';version='[4,5)',\
	bnd.identity;id='org.gecko.emf.osgi.component';version='[4,5)',\
	bnd.identity;id='jakarta.servlet-api';version:Version='6.0.0'
-runproperties: \
	osgi.console=,\
	org.osgi.service.http.port=-1,\
	gosh.args=--noshutdown,\
	osgi.shell.telnet.port=4003

-runbundles: \
	com.fasterxml.jackson.core.jackson-annotations;version='[2.16.0,2.16.1)',\
	com.fasterxml.jackson.core.jackson-core;version='[2.16.0,2.16.1)',\
